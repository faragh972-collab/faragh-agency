# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ADMIN_PASSWORD: Required to access the admin dashboard and protected write APIs.
ADMIN_PASSWORD="CHANGE_TO_A_LONG_RANDOM_PASSWORD"
ADMIN_SESSION_SECRET="CHANGE_TO_AN_INDEPENDENT_64_CHARACTER_RANDOM_SECRET"

# MongoDB Atlas connection string used for persistent content storage.
MONGODB_URI="mongodb+srv://USER:PASSWORD@CLUSTER/faragh?retryWrites=true&w=majority"

# Added automatically after connecting a Vercel Blob store to the project.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_TOKEN"

# Optional Gemini model override.
GEMINI_MODEL="gemini-2.5-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
